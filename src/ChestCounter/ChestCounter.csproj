<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NBFC TRACKER</AssemblyName>
    <RootNamespace>ChestCounter</RootNamespace>
    <Title>NBFC TRACKER</Title>
    <Product>NBFC TRACKER</Product>
    <Company>NimnaBro</Company>
    <Authors>NimnaBro</Authors>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Description>NBFC TRACKER - Open Source Fortnite Chest Counter &amp; Live OBS Overlay - Created by NimnaBro</Description>
    <Copyright>Copyright © 2026 NimnaBro. All rights reserved.</Copyright>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Uncompressed single-file publishing; antivirus results depend on the scanner. -->
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Small idle footprint -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\lib\FortniteReplayReader\FortniteReplayReader.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="..\..\v3\public\**\*" LinkBase="public" />
  </ItemGroup>
</Project>
